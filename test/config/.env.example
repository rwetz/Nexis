# .env.example — Nexis editor playground
# Copy to .env and fill in real values. Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────

APP_NAME=nexis
APP_VERSION=1.3.0
APP_ENV=development                  # development | staging | production
APP_PORT=8080
APP_HOST=0.0.0.0
APP_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:8080

# ── Database ──────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://nexis_user:password@localhost:5432/nexis_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000    # ms
DATABASE_SSL=false                  # true in production

# SQLite (alternative to Postgres)
SQLITE_PATH=./data/nexis.db

# ── Redis ─────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ── Auth / JWT ────────────────────────────────────────────────────────────────

JWT_SECRET=super-secret-jwt-key-min-32-chars-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another-long-secret-for-refresh-tokens
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=cookie-signing-secret

# OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/auth/github/callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# ── AI / LLM ──────────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=8096

OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Object storage ────────────────────────────────────────────────────────────

# AWS S3
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=nexis-dev-artifacts
AWS_S3_ENDPOINT=                     # leave empty for real AWS; set for MinIO/LocalStack

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ── Email ─────────────────────────────────────────────────────────────────────

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nexis <noreply@nexis.dev>"
SMTP_SECURE=false                    # true for port 465

# Resend
RESEND_API_KEY=re_...

# ── Telemetry ─────────────────────────────────────────────────────────────────

# Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=nexis-backend
OTEL_SERVICE_VERSION=${APP_VERSION}

# Posthog
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# ── Feature flags ─────────────────────────────────────────────────────────────

FEATURE_AI_CHAT=true
FEATURE_DEBUGGER=true
FEATURE_COLLABORATION=false
FEATURE_ANALYTICS=false

# ── CDN / assets ─────────────────────────────────────────────────────────────

CDN_URL=
STATIC_URL=/static

# ── Development / debug ───────────────────────────────────────────────────────

LOG_LEVEL=debug                      # trace | debug | info | warn | error
LOG_FORMAT=pretty                    # pretty | json
RUST_LOG=nexis=debug,tower_http=debug
RUST_BACKTRACE=1

NODE_ENV=development
VITE_DEV_SERVER_HOST=localhost
VITE_DEV_SERVER_PORT=5173

# Hot-reload tauri window on Vite HMR
TAURI_SKIP_DEVSERVER_CHECK=false

# ── Security ─────────────────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
CSRF_SECRET=csrf-secret-key

# ── Miscellaneous ────────────────────────────────────────────────────────────

TZ=UTC
LANG=en_US.UTF-8
NODE_OPTIONS=--max-old-space-size=4096
